  "tokenColors": [
    {
      "name": "Default text",
      "scope": [
        "source",
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.function-call",
        "punctuation",
        "keyword.operator",
        "entity.name.function.call",
        "support.function"
      ],
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#808080",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.double-slash.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#629755",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "storage.type.class.doxygen",
        "storage.type.class.jsdoc",
        "storage.type.class.gtkdoc",
        "comment keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#629755",
        "fontStyle": "bold italic underline"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.sizeof",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.cast",
        "keyword.operator.alignof",
        "keyword.operator.wordlike",
        "constant.language.boolean",
        "variable.language.this",
        "constant.language.nullptr",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "meta.preprocessor keyword"
      ],
      "settings": {
        "foreground": "#CC7832",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted.other.lt-gt.include",
        "meta.preprocessor.include string"
      ],
      "settings": {
        "foreground": "#6A8759",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes & format specifiers",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.character.format.placeholder",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#CC7832",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit.suffix",
        "keyword.other.suffix.literal"
      ],
      "settings": {
        "foreground": "#6897BB",
        "fontStyle": ""
      }
    },
    {
      "name": "Semicolon & comma",
      "scope": [
        "punctuation.terminator.statement",
        "punctuation.separator.delimiter",
        "punctuation.separator.comma",
        "punctuation.separator.parameters",
        "punctuation.separator.parameter",
        "punctuation.separator.argument",
        "punctuation.separator.delimiter.comma"
      ],
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function",
        "meta.function.definition entity.name.function",
        "meta.function.definition.parameters entity.name.function"
      ],
      "settings": {
        "foreground": "#FFC66D"
      }
    },
    {
      "name": "Function calls (CLion: plain)",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.c entity.name.function",
        "meta.function-call.cpp entity.name.function",
        "entity.name.function.member",
        "meta.function-call.member entity.name.function"
      ],
      "settings": {
        "foreground": "#A9B7C6"
      }
    },
    {
      "name": "Macros",
      "scope": [
        "entity.name.function.preprocessor",
        "entity.name.other.preprocessor.macro",
        "variable.other.macro",
        "entity.name.function.macro",
        "meta.preprocessor.macro entity.name",
        "support.constant.macro"
      ],
      "settings": {
        "foreground": "#908B25"
      }
    },
    {
      "name": "NULL / std streams (macros in libc)",
      "scope": [
        "constant.language.null",
        "support.variable.c",
        "support.constant.c"
      ],
      "settings": {
        "foreground": "#908B25"
      }
    },
    {
      "name": "Struct / class names",
      "scope": [
        "entity.name.type.struct",
        "entity.name.type.class",
        "entity.name.type.union",
        "entity.name.type.enum",
        "storage.type.struct",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#B5B6E3"
      }
    },
    {
      "name": "Typedefs & types",
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.built-in.primitive.c",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#B9BCD1"
      }
    },
    {
      "name": "Built-in primitive types are keywords",
      "scope": [
        "storage.type.built-in",
        "storage.type.primitive",
        "storage.type.built-in.primitive"
      ],
      "settings": {
        "foreground": "#CC7832"
      }
    },
    {
      "name": "Fields",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#9373A5"
      }
    },
    {
      "name": "Enum members / constants",
      "scope": [
        "variable.other.enummember",
        "entity.name.variable.enum-member",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#9876AA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "entity.name.type.template",
        "entity.name.type.parameter"
      ],
