// Merged into every VS Code profile's settings.json by install.sh (macOS)
// or install.ps1 (Windows). Values mirror the JetBrains IDE (New UI) defaults.
{
  // theme
  "workbench.colorTheme": "Flying Island Dark",
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-dark",
  "workbench.productIconTheme": "Default",

  // editor font: CLion default = JetBrains Mono 13, line spacing 1.2
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontSize": 13,
  "editor.lineHeight": 22,
  "editor.fontLigatures": false,
  "editor.fontWeight": "normal",
  "editor.letterSpacing": 0,

  // editor look
  "editor.renderLineHighlight": "all",
  "editor.cursorWidth": 2,
  "editor.cursorBlinking": "blink",
  "editor.minimap.enabled": false,
  "editor.rulers": [120],
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": false,
  "editor.guides.bracketPairs": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 5,
  "editor.showFoldingControls": "mouseover",
  "editor.folding": true,
  "editor.glyphMargin": true,
  "editor.lineDecorationsWidth": 12,
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.scrollbar.verticalScrollbarSize": 10,
  "editor.scrollbar.horizontalScrollbarSize": 10,
  "editor.scrollBeyondLastLine": true,
  "editor.padding.top": 4,
  "editor.occurrencesHighlight": "singleFile",
  "editor.semanticHighlighting.enabled": true,
  "editor.renderWhitespace": "none",
  "editor.unicodeHighlight.ambiguousCharacters": false,

  // inlay hints (filename: / mode: / size:) like CLion
  "editor.inlayHints.enabled": "on",
  "editor.inlayHints.fontFamily": "Inter",
  "editor.inlayHints.fontSize": 11,
  "editor.inlayHints.padding": true,

  // glass: native blur behind title bar / stripe / status bar / Project
  //     (macOS vibrancy; on Windows 11 the extension maps it to acrylic)
  "flyingIsland.vibrancy": "under-window",
  "flyingIsland.vibrancyOpacity": 0.4,

  // window chrome
  // VS Code 1.14x enables an experimental "modern UI" by default; the classic
  // layout + css/islands.css matches CLion exactly (separate tool window stripe).
  "workbench.experimental.modernUI": false,
  "window.titleBarStyle": "custom",
  "window.commandCenter": true,
  "workbench.layoutControl.enabled": false,
  "breadcrumbs.enabled": false,
  "workbench.editor.tabActionCloseVisibility": true,
  "workbench.editor.tabSizing": "fit",
  "workbench.editor.wrapTabs": false,
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.enableStickyScroll": false,
  "workbench.list.smoothScrolling": true,
  "workbench.activityBar.location": "default",
  "workbench.sideBar.location": "left",

  // terminal / run console
  "terminal.integrated.fontFamily": "JetBrains Mono",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,

  // C/C++: clangd gives the same semantic colors as CLion Nova
  //     (stdout / strcpy / NULL as macros, declarations vs calls, inlay hints)
  // clangd comes from PATH (macOS: Xcode CLT); on Windows the clangd
  // extension offers to download it on first use.
  "clangd.arguments": ["--header-insertion=never", "--clang-tidy"],
  "C_Cpp.intelliSenseEngine": "disabled",
  "[c]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "[cpp]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" }
}
